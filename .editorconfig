root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt に合わせる。
[{*.go,go.mod,go.sum}]
indent_style = tab

[justfile]
indent_size = 4

# 行末の空白 2 つは Markdown の改行になる。
[*.md]
trim_trailing_whitespace = false
