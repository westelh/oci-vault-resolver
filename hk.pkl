amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local goFiles = List("**/*.go", "go.mod", "go.sum")

local fmtCheck = new Config.Step {
  glob = "**/*.go"
  check = "just fmt-check"
}

local vet = new Config.Step {
  glob = goFiles
  check = "just vet"
}

local lint = new Config.Step {
  glob = List("**/*.go", "go.mod", "go.sum", ".golangci.yml")
  check = "just lint"
}

// typos は対象をリポジトリ全体から自分で集めるので、glob で絞らない。
local typos = new Config.Step {
  check = "just typos"
}

local test = new Config.Step {
  glob = goFiles
  check = "just test"
}

local actionlint = new Config.Step {
  glob = ".github/workflows/**"
  check = "just actionlint"
}

local zizmor = new Config.Step {
  glob = List(".github/workflows/**", ".github/dependabot.yml")
  check = "just zizmor"
}

hooks {
  ["pre-commit"] {
    stash = "git"
    steps {
      ["fmt-check"] = fmtCheck
      ["vet"] = vet
      ["lint"] = lint
      ["actionlint"] = actionlint
      ["zizmor"] = zizmor
      ["typos"] = typos
    }
  }
  ["check"] {
    steps {
      ["fmt-check"] = fmtCheck
      ["vet"] = vet
      ["lint"] = lint
      ["actionlint"] = actionlint
      ["zizmor"] = zizmor
      ["typos"] = typos
      ["test"] = test
    }
  }
}
