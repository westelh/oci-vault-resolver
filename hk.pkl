amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local goFiles = List("**/*.go", "go.mod", "go.sum")

local fmtCheck = new Config.Step {
  glob = "**/*.go"
  check = "just fmt-check"
}

local vet = new Config.Step {
  glob = goFiles
  check = "just vet"
}

local test = new Config.Step {
  glob = goFiles
  check = "just test"
}

hooks {
  ["pre-commit"] {
    stash = "git"
    steps {
      ["fmt-check"] = fmtCheck
      ["vet"] = vet
    }
  }
  ["check"] {
    steps {
      ["fmt-check"] = fmtCheck
      ["vet"] = vet
      ["test"] = test
    }
  }
}
